def _detect_lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(var, "")
        if not val:
            continue
        base = val.split(".")[0].split("@")[0]
        if base in MSGS:
            return base
        short = base.split("_")[0]
        if short in MSGS:
            return short
    return "en"

LANG = _detect_lang()

def _(key, **kw):
    s = MSGS.get(LANG, MSGS["en"]).get(key, MSGS["en"][key])
    return s.format(**kw) if kw else s

def config_path():
    """Caminho do config: env T02_CONFIG, senao ~/.config/t02.conf do DONO do script
    (via uid do arquivo) -- necessario pois o backend CUPS roda como root."""
    if os.environ.get("T02_CONFIG"):
        return os.environ["T02_CONFIG"]
    owner_home = pwd.getpwuid(os.stat(__file__).st_uid).pw_dir
    return os.path.join(owner_home, ".config", "t02.conf")

def load_mac():
    """Ordem: env T02_MAC; senao le [t02] mac do config. None se nao achar."""
    if os.environ.get("T02_MAC"):
        return os.environ["T02_MAC"]
    cfg = configparser.ConfigParser()
    if cfg.read(config_path()) and cfg.has_option("t02", "mac"):
        return cfg.get("t02", "mac")
    return None

def save_mac(mac):
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    cfg = configparser.ConfigParser()
    cfg["t02"] = {"mac": mac}
    with open(path, "w") as f:
        cfg.write(f)
    return path

def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True

@contextlib.contextmanager
def print_lock():
    """Serializa impressoes entre processos (2 terminais, ou terminal + CUPS-root) em
    fila FIFO: ticket com PID em t02.queue (secoes curtas protegidas pelo flock da
    propria fila), exclusao real do job via flock bloqueante em t02.lock, espera
    infinita (sem timeout). PIDs mortos sao descartados a cada releitura da fila.
    0666 pois root (CUPS) e o dono do script precisam acessar os mesmos arquivos."""
    lock_path = os.path.join(os.path.dirname(config_path()), "t02.lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o666)
    os.fchmod(lock_fd, 0o666)  # umask ignora o modo do open; fchmod garante mesmo se root criou antes

    queue_path = os.path.join(os.path.dirname(config_path()), "t02.queue")
    qfd = os.open(queue_path, os.O_CREAT | os.O_RDWR, 0o666)
    os.fchmod(qfd, 0o666)

    def read_tickets():
        os.lseek(qfd, 0, os.SEEK_SET)
        lines = os.read(qfd, 1 << 20).decode().splitlines()
        tickets = [tuple(map(int, l.split())) for l in lines if l.strip()]
        return [t for t in tickets if _pid_alive(t[1])]  # descarta PIDs mortos

    def write_tickets(tickets):
        os.lseek(qfd, 0, os.SEEK_SET)
        os.truncate(qfd, 0)
        os.write(qfd, "".join(f"{n} {p}\n" for n, p in tickets).encode())

    fcntl.flock(qfd, fcntl.LOCK_EX)
    tickets = read_tickets()
    my_ticket = (tickets[-1][0] + 1) if tickets else 1
    tickets.append((my_ticket, os.getpid()))
    write_tickets(tickets)
    fcntl.flock(qfd, fcntl.LOCK_UN)

    warned = False
    try:
        while True:
            fcntl.flock(qfd, fcntl.LOCK_EX)
            tickets = read_tickets()
            write_tickets(tickets)
            fcntl.flock(qfd, fcntl.LOCK_UN)
            if tickets and tickets[0][0] == my_ticket:
                break
            if not warned:
                print(_("waiting_lock"), file=sys.stderr)
                warned = True
            time.sleep(0.2)

        fcntl.flock(lock_fd, fcntl.LOCK_EX)  # ja e minha vez; so protege contra processo fora da fila
        yield
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)
        fcntl.flock(qfd, fcntl.LOCK_EX)
        write_tickets([t for t in read_tickets() if t[1] != os.getpid()])
        fcntl.flock(qfd, fcntl.LOCK_UN)
        os.close(qfd)

def setup_wizard():
    print(_("setup_step1"))
    input(_("setup_enter"))
    print(_("setup_scanning"))
    found = asyncio.run(BleakScanner.discover(timeout=15, return_adv=True))
    items = list(found.values())  # [(BLEDevice, AdvertisementData), ...]
    if not items:
        sys.exit(_("setup_no_devices"))
    def is_t02(d, adv):
        name = d.name or adv.local_name or ""
        uuids = [str(u).lower() for u in (adv.service_uuids or [])]
        return name.startswith(("T02", "Mr.in")) or any("ff00" in u for u in uuids)
    for i, (d, adv) in enumerate(items):
        tag = "  <-- T02?" if is_t02(d, adv) else ""
        print(f"{i}: {d.name or '(sem nome)'} [{d.address}] RSSI={adv.rssi}{tag}")
    choice = input(_("setup_choice")).strip()
    if ":" in choice:
        mac = choice.upper()
    else:
        mac = items[int(choice)][0].address.upper()
    path = save_mac(mac)
    print(_("setup_saved", path=path))
    if input(_("setup_validate")).strip().lower() == _("setup_validate_yes"):
        global MAC
        MAC = mac
        asyncio.run(print_info())

class _Underline(__import__("markdown").Extension):
    """Extensao markdown: ++texto++ -> <u>texto</u>."""
    def extendMarkdown(self, md):
        from markdown.inlinepatterns import SimpleTagInlineProcessor
        md.inlinePatterns.register(SimpleTagInlineProcessor(r"(\+\+)(.+?)\+\+", "u"), "underline", 65)


